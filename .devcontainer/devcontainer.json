{
  "name": "BenefitIQ (Python 3.12)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && cp -n .env.example .env || true",
  "forwardPorts": [8000, 8501],
  "portsAttributes": {
    "8000": {"label": "BenefitIQ API", "onAutoForward": "notify"},
    "8501": {"label": "BenefitIQ UI", "onAutoForward": "openBrowser"}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {"python.defaultInterpreterPath": "/usr/local/bin/python"}
    }
  }
}
