# =====================================================================
# BenefitIQ settings (Claude on Amazon Bedrock). Copy this file to ".env".
#   Windows PowerShell:  Copy-Item .env.example .env
# Never commit the real .env file (it is in .gitignore).
# =====================================================================

# ===== AWS / Amazon Bedrock =====
# Region where you enabled the models. us-east-1 (N. Virginia) has every model.
AWS_REGION=us-east-1

# Credentials - choose ONE option:
#  Option A (easiest): a Bedrock API key from Bedrock console -> API keys.
#  Long-term keys are ~132 characters starting with ABSK (not the BedrockAPIKey-xxxx name).
AWS_BEARER_TOKEN_BEDROCK=paste-your-bedrock-api-key-here
#  Option B: run "aws configure" once (IAM user access key), then leave the line above
#            as it is. To use a named profile instead of "default", fill this in:
AWS_PROFILE=

# Claude models (cross-region inference profile IDs - keep the "us." prefix).
# If the newest model says "not available for this account", use an older one, e.g.
#   us.anthropic.claude-sonnet-4-5-20250929-v1:0   (see docs/AWS_SETUP.md)
BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-sonnet-5
# Used automatically if the main model fails (throttling, timeout, outage). "none" = off.
BEDROCK_FALLBACK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=2048

# Embeddings: Amazon Titan Text Embeddings V2 (runs in your region, no "us." prefix).
# If you change the model or dimensions, re-run: python scripts/ingest.py --reset
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIMENSIONS=1024
# bedrock | fake   (fake = offline hashing, for tests/CI only, no AWS calls)
EMBEDDING_PROVIDER=bedrock

# ===== LangSmith tracing (free Developer plan) =====
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=paste-your-langsmith-key-here
LANGSMITH_PROJECT=benefitiq
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ===== CMS Blue Button 2.0 sandbox (optional: synthetic Medicare claims) =====
# Register a sandbox app at https://sandbox.bluebutton.cms.gov (see docs/BLUE_BUTTON_SETUP.md).
BLUEBUTTON_BASE_URL=https://sandbox.bluebutton.cms.gov
BLUEBUTTON_API_VERSION=v2
BLUEBUTTON_CLIENT_ID=
BLUEBUTTON_CLIENT_SECRET=paste-your-bluebutton-client-secret-here
BLUEBUTTON_REDIRECT_URI=http://localhost:8765/callback
BLUEBUTTON_TOKEN_DIR=data/bluebutton
BLUEBUTTON_TIMEOUT_SECONDS=30

# ===== App behaviour =====
CHROMA_DIR=data/chroma
MEMBER_DB_PATH=data/synthetic/members.db
CACHE_DIR=data/cache
CACHE_TTL_SECONDS=86400
RETRIEVAL_TOP_K=5
HITL_CONFIDENCE_THRESHOLD=0.6
MAX_JSON_RETRIES=2
INJECTION_LLM_CHECK=false
LLM_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
API_URL=http://localhost:8000
